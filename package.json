{
  "name": "phancu-portfolio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3200",
    "lint": "eslint .",
